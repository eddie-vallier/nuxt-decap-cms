{
  "name": "nuxt-decap-cms",
  "version": "1.0.1",
  "description": "Nuxt Decap CMS is an unofficial Nuxt module designed to seamlessly integrate Decap CMS (formerly Netlify CMS) into any Nuxt project. It aims for smooth compatibility with Nuxt Content, provides live preview capabilities for edited content, and supports automatic integration of stateless components.",
  "repository": "eddie-vallier/nuxt-decap-cms",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "release": "changeset publish",
    "version": "changeset version && changelogen",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
    "test:types:fix": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@nuxt/kit": "^3.17.3"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.4",
    "@nuxt/content": "3.5.1",
    "@nuxt/devtools": "^2.4.1",
    "@nuxt/eslint": "1.4.1",
    "@nuxt/eslint-config": "^1.4.0",
    "@nuxt/fonts": "0.11.4",
    "@nuxt/icon": "1.13.0",
    "@nuxt/image": "1.10.0",
    "@nuxt/module-builder": "^1.0.1",
    "@nuxt/schema": "^3.17.3",
    "@nuxt/scripts": "0.11.7",
    "@nuxt/test-utils": "^3.19.0",
    "@nuxt/ui": "3.1.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "latest",
    "@unhead/vue": "^2.0.3",
    "changelogen": "^0.6.1",
    "eslint": "^9.27.0",
    "js-yaml": "^4.1.0",
    "nuxt": "^3.17.3",
    "typescript": "~5.8.3",
    "vitest": "^3.1.4",
    "vue-tsc": "^2.2.10"
  },
  "peerDependencies": {
    "zod": "^3.23.8",
    "defu": "^6.1.4",
    "c12": "^3.0.3"
  }
}
